# Copy to .env.local and fill in. .env.local is gitignored.
#
# WARNING: every VITE_* value is inlined into the client bundle at build time.
# It is configuration, not a secret store. Never put the bridge ADMIN_TOKEN,
# JWT_SECRET or DATABASE_URL here — those belong in server/.env only.

# TMDB — https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=
VITE_TMDB_TOKEN=

# Streaming bridge (the Node server in server/)
VITE_STREAM_SERVER=http://127.0.0.1:8899

# Optional: only used by the direct-to-Prowlarr fallback when the bridge proxy
# is unreachable. The normal path goes through the bridge, which holds the key.
VITE_PROWLARR_URL=http://localhost:9696
VITE_PROWLARR_KEY=
